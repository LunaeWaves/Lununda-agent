# Lununda Agent — Docker Compose environment.
# Copy to .env and edit; .env is loaded automatically by docker compose.

# ─── Image ───────────────────────────────────────────────────────────────
# GHCR tag for the Lununda Agent image. Use:
#   dev          — bleeding edge from dev branch (default until v1 ships)
#   latest       — stable release from main
#   v1.2.3       — pinned release
#   sha-abcdef   — pinned commit
LUNUNDA_VERSION=dev

# When to pull the image. Common values:
#   missing  (default) — only pull if not present locally
#   always            — pull on every up
#   never             — never pull (offline / air-gapped)
LUNUNDA_PULL_POLICY=missing

# ─── Network ─────────────────────────────────────────────────────────────
# Host port the gateway binds to. Container always listens on 18953.
LUNUNDA_PORT=18953

# ─── Runtime ─────────────────────────────────────────────────────────────
# IANA timezone — last-resort fallback for agent cron schedules.
TZ=Asia/Shanghai

# Log verbosity: debug / info / warn / error
LUNUNDA_LOG_LEVEL=info

# ─── Postgres (only used with docker-compose.postgres.yml override) ──────
POSTGRES_PASSWORD=change-me-to-a-real-password

# ─── Sandbox (used by docker-compose.ghcr-sandbox.yml + sandbox override) ─
# Override the sandbox image (defaults to ghcr.io/lunaewaves/lununda-sandbox:dev).
# LUNUNDA_SANDBOX_IMAGE=ghcr.io/lunaewaves/lununda-sandbox:dev

# Host directory for the lununda data dir when using the sandbox compose.
# MUST be an ABSOLUTE PATH that exists on the host, and is mounted to the
# same path inside the container. The sibling-container pattern passes
# the gateway's in-container workspace path verbatim to `docker create -v`,
# so the host has to resolve that exact path. Default: /var/lib/lununda.
# Examples:
#   /var/lib/lununda       (default, root-owned, recommended for Linux hosts)
#   /opt/lununda           (alternative root-owned path)
#   /www/lununda           (common on cPanel/BT-panel hosts)
# Avoid relative paths (./data) — they break the sandbox mount.
# LUNUNDA_DATA_DIR=/var/lib/lununda
